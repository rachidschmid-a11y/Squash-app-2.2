# Vorlage für die lokalen Secrets dieser App.
#
# So verwenden:
#   1. Diese Datei nach .streamlit/secrets.toml kopieren:
#        cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   2. In der Kopie die Platzhalter unten durch echte Werte ersetzen.
#
# .streamlit/secrets.toml ist in .gitignore eingetragen und wird NIEMALS
# committet. Für das Deployment auf Streamlit Community Cloud werden die
# gleichen Werte stattdessen unter "Advanced settings -> Secrets" im
# TOML-Format eingetragen (siehe README.md, Setup Schritt 4).

# Supabase-Projekt-URL (Project Settings -> API Keys -> Project URL)
SUPABASE_URL = "https://euer-projekt.supabase.co"

# Supabase Publishable Key (moderner Nachfolger des klassischen anon-Keys;
# Project Settings -> API Keys). NIEMALS den Secret/service_role-Key hier
# eintragen - der würde Row Level Security komplett umgehen.
SUPABASE_KEY = "euer-publishable-oder-anon-key"

# Optional, aber empfohlen: gemeinsames Passwort für die App (auth.py).
# Fehlt dieser Eintrag komplett, läuft die App ohne Zugriffsschutz (mit
# deutlichem Warnhinweis in der Oberfläche).
APP_PASSWORD = "ein-sicheres-passwort"
